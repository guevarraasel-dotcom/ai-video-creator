name: Build AI Video Creator APK

on:
  workflow_dispatch:
  push:
    paths:
      - 'ai_video_creator_phone_build_pack.zip'
      - '.github/workflows/build apk.yml'

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Unpack phone build pack
        run: |
          test -f AI_Video_Creator_Phone_Build_Pack.zip
          unzip -q AI_Video_Creator_Phone_Build_Pack.zip -d unpacked
          test -f unpacked/AI_Video_Creator_Android_Project/settings.gradle

      - name: Build debug APK
        working-directory: unpacked/AI_Video_Creator_Android_Project
        run: gradle --no-daemon assembleDebug

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: AI-Video-Creator-debug-APK
          path: unpacked/AI_Video_Creator_Android_Project/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 7
